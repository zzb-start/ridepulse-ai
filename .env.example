# RidePulse AI 环境变量模板
# 复制此文件为 .env 并填入真实值
# .env 绝对不能提交到 Git

RIDEPULSE_ENV=development
RIDEPULSE_DB_PATH=data/ridepulse.db
RIDEPULSE_OUTPUT_DIR=output

# ── LLM：OpenAI GPT-6 系列 ─────────────────────────────────
# 端点与凭证（不填 LLM_API_KEY 时读 OPENAI_API_KEY）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# 模型分层：三层各司其职，替换档位只改这三行，代码不动
# 首轮分类：单条调用量大、输出结构固定，用低成本档跑量
LLM_PRIMARY_MODEL=gpt-6-luna
# 独立复判：必须与首轮不同模型，"双模型独立"才成立
LLM_REVIEW_MODEL=gpt-6-sol
# 证据卡：长上下文综合 + 严格引用约束，用旗舰档
LLM_EVIDENCE_MODEL=gpt-6-astra

# 推理强度：GPT-6 起取消 none / minimal，合法值为 low / medium / high / xhigh / max
# 留空则按阶段默认：分类 low / 复判 medium / 证据卡 high；填一个值即全局覆盖
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ── Embedding ─────────────────────────────────────────────
# api: 走同一端点的 text-embedding-3-large（3072 维）
# local: 本地多语言模型，不消耗 API 额度（CI 周更流水线用这个）
# fake: 仅测试
EMBEDDING_MODE=api
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# ── 飞书开放平台 ──────────────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_FEEDBACK_TABLE_ID=
FEISHU_EVIDENCE_TABLE_ID=
FEISHU_REVIEW_TABLE_ID=
FEISHU_EXPERIMENT_TABLE_ID=
