# RidePulse AI 环境变量模板
# 复制此文件为 .env 并填入真实值
# .env 绝对不能提交到 Git

RIDEPULSE_ENV=development
RIDEPULSE_DB_PATH=data/ridepulse.db
RIDEPULSE_OUTPUT_DIR=output

# LLM 配置（OpenAI 兼容接口）
LLM_BASE_URL=
LLM_API_KEY=
LLM_PRIMARY_MODEL=
LLM_REVIEW_MODEL=
LLM_EVIDENCE_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Embedding 配置
EMBEDDING_MODE=api
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# 飞书开放平台
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_FEEDBACK_TABLE_ID=
FEISHU_EVIDENCE_TABLE_ID=
FEISHU_REVIEW_TABLE_ID=
FEISHU_EXPERIMENT_TABLE_ID=
